# Copy to .env and fill in. Learning deployment profile: free tiers only, total spend <= USD 10/month (SPEC.md NFR-36).
MONTHLY_SPEND_CAP_USD=10

# Local backbone (deploy/compose.yaml)
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent
OPENBAO_DEV_TOKEN=change-me

# Optional free managed replacements (leave empty to use the local containers)
# Postgres (docs/aiven.md): postgresql://avnadmin:<password>@<host>:<port>/defaultdb?sslmode=require
# For verify-full add &sslrootcert=/path/to/ca.pem (or set PGSSLMODE / PGSSLROOTCERT instead).
DATABASE_URL=
# App login without BYPASSRLS (register S17): DATABASE_URL with the user app_login (deploy/vm/migrate.py gives
# it the owner's password). Migrations keep using DATABASE_URL.
APP_DATABASE_URL=
# Connection budget per API process (data.pool): DB_POOL_MAX + DB_STORE_POOL_MAX + 1 LISTEN must stay within
# the server's free connections (Aiven free: max_connections 20, some reserved; keep the total <= 12).
DB_POOL_MIN=1
DB_POOL_MAX=8
DB_STORE_POOL_MAX=2
# Disk quota for deploy/vm/db_size.py's warning (exit 1 at 80 %)
DB_DISK_LIMIT_MB=1024
# Staff console sign-in (channels.api.staff): emails allowed into /v1/staff/*, comma-separated. Empty = nobody.
STAFF_EMAILS=
QDRANT_URL=
QDRANT_API_KEY=

# Free managed services
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Models: free tiers by default; Claude only for the hardest turns.
# Set a USD 10 monthly spend limit in the Anthropic console before adding this key.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
